<UserControl
    x:Class="ImageManager.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ImageManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataModels="clr-namespace:ImageManager.Data.Model"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:viewModels="clr-namespace:ImageManager.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <hc:ThemeResources />
                <hc:Theme />
                <ResourceDictionary>
                    <hc:BindingProxy x:Key="Proxy" Value="{Binding}" />

                    <!--  卡片底部的小标签  -->
                    <Style
                        x:Key="AppTagSmall"
                        BasedOn="{StaticResource TagBaseStyle}"
                        TargetType="hc:Tag">
                        <Setter Property="Margin" Value="0,1,6,0" />
                        <Setter Property="Padding" Value="7,2" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
                    </Style>

                    <!--  图片卡片  -->
                    <Style
                        x:Key="PictureCard"
                        BasedOn="{StaticResource CardBaseStyle}"
                        TargetType="hc:Card">
                        <Setter Property="Margin" Value="0,7" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeBrush}" />
                        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
                        <Setter Property="Effect" Value="{StaticResource AppCardShadow}" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="10" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="0" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate DataType="viewModels:PictureSelectableItemWrapper">
                                    <hc:SimplePanel>
                                        <!--  图片本体，顶角跟随卡片圆角；不添加时整块变暗  -->
                                        <Border
                                            controls:CornerClip.TopRadius="10"
                                            Background="{DynamicResource AppImageBackdropBrush}"
                                            Opacity="{Binding ContentOpacity}">
                                            <Image
                                                s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                MouseLeftButtonDown="{s:Action StickPicture}"
                                                Source="{Binding Item.ImageUri}"
                                                Stretch="Uniform" />
                                        </Border>

                                        <!--  不添加：中央大字  -->
                                        <Border
                                            Padding="24,10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AppRejectChipBrush}"
                                            BorderBrush="{StaticResource AppRejectChipStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsRejected, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock
                                                FontSize="21"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource AppRejectChipTextBrush}"
                                                Text="不添加" />
                                        </Border>

                                        <!--  悬停快捷操作（添加图片界面不显示）  -->
                                        <StackPanel
                                            Margin="0,0,10,12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=hc:Card}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button
                                                s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                Command="{s:Action StickPictureOf}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppRoundIconButton}"
                                                ToolTip="贴片式打开">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="M12 17v5M8 3h8l-1.2 6.2 2.7 2.8V14H6.5v-2l2.7-2.8z"
                                                    Stretch="Uniform"
                                                    Stroke="{DynamicResource SecondaryTextBrush}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.8" />
                                            </Button>
                                            <Button
                                                s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                Command="{s:Action OpenPictureOf}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppRoundIconButton}"
                                                ToolTip="用外部程序打开">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="M14 4h6v6M20 4l-8.5 8.5M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"
                                                    Stretch="Uniform"
                                                    Stroke="{DynamicResource SecondaryTextBrush}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.8" />
                                            </Button>
                                        </StackPanel>

                                        <!--  添加模式：左上圆形勾（接受 / 未接受）  -->
                                        <CheckBox
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsChecked="{Binding AcceptToAdd}"
                                            IsEnabled="{Binding IsEnabled}"
                                            Style="{StaticResource AppCircleCheck}"
                                            Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.Instance}}" />

                                        <!--  冲突角标：重复 / 相似  -->
                                        <Border
                                            Margin="0,9,9,0"
                                            Padding="7,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource DangerBrush}"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsConflict, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock
                                                FontSize="10.5"
                                                Foreground="White"
                                                Text="{Binding ConflictText}" />
                                        </Border>
                                    </hc:SimplePanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FooterTemplate">
                            <Setter.Value>
                                <DataTemplate DataType="viewModels:PictureSelectableItemWrapper">
                                    <StackPanel Margin="12,10,12,12" Opacity="{Binding ContentOpacity}">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{Binding Item.Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <DockPanel>
                                            <hc:TagContainer
                                                Margin="0,7,0,0"
                                                BorderThickness="0"
                                                ItemsSource="{Binding Item.Labels}"
                                                PreviewMouseWheel="InnerLB_PreviewMouseWheel">
                                                <hc:TagContainer.ItemTemplate>
                                                    <DataTemplate DataType="dataModels:Label">
                                                        <Button
                                                            Margin="0,2,0,0"
                                                            Padding="0"
                                                            s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{s:Action PictureLabelClick}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding Name}" />
                                                    </DataTemplate>
                                                </hc:TagContainer.ItemTemplate>
                                                <hc:TagContainer.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource AppTagSmall}" TargetType="hc:Tag">
                                                        <Setter Property="Content" Value="{Binding}" />
                                                    </Style>
                                                </hc:TagContainer.ItemContainerStyle>
                                            </hc:TagContainer>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource AppHoverShadow}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!--  瀑布流列表  -->
                    <Style
                        x:Key="PictureListBox"
                        BasedOn="{StaticResource ListBoxCustom}"
                        TargetType="ListBox">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="SelectionMode" Value="Extended" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <hc:WaterfallPanel
                                        Margin="0,8"
                                        hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}"
                                        AutoGroup="True"
                                        DesiredLength="{Binding Value.CardWidth, Source={StaticResource Proxy}}" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemTemplate">
                            <Setter.Value>
                                <DataTemplate DataType="viewModels:PictureSelectableItemWrapper">
                                    <hc:Card
                                        Width="{Binding Value.CardWidth, Source={StaticResource Proxy}}"
                                        Content="{Binding}"
                                        Footer="{Binding}"
                                        Style="{StaticResource PictureCard}">
                                        <hc:Card.ContextMenu>
                                            <ContextMenu>
                                                <!--  普通模式  -->
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action StickPictureCommand}"
                                                    Header="贴片式打开"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M12 17v5M8 3h8l-1.2 6.2 2.7 2.8V14H6.5v-2l2.7-2.8z"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource PrimaryTextBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.8" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action OpenPictureWithExternalProgram}"
                                                    Header="使用外部程序打开"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M14 4h6v6M20 4l-8.5 8.5M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource PrimaryTextBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.8" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}" />
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action CopyPicture}"
                                                    Header="拷贝图片"
                                                    InputGestureText="Ctrl+C"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M9 9h10v10H9zM5 15V5h10"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource PrimaryTextBrush}"
                                                            StrokeLineJoin="Round"
                                                            StrokeThickness="1.8" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action CopyPicturePath}"
                                                    Header="拷贝图片路径"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M4 6h16M4 12h10M4 18h7"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource PrimaryTextBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.8" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}" />

                                                <!--  两种模式都有  -->
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action AddPictureLabel}"
                                                    Header="添加标签">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82zM7 7h.01"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource PrimaryTextBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.8" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <!--  普通模式：删除  -->
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action DeletePicture}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Header="删除图片"
                                                    InputGestureText="Delete"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource DangerBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.8" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <!--  添加模式：接受 / 拒绝  -->
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action AcceptAdd}"
                                                    Header="接受添加"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M5 13l4 4L19 7"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource PrimaryTextBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="2" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    s:View.ActionTarget="{Binding Value, Source={StaticResource Proxy}}"
                                                    Command="{s:Action RejectAdd}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Header="拒绝添加"
                                                    Visibility="{Binding Value.IsAddPictureMode, Source={StaticResource Proxy}, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                                                    <MenuItem.Icon>
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="M6 6l12 12M18 6L6 18"
                                                            Stretch="Uniform"
                                                            Stroke="{DynamicResource DangerBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="2" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </hc:Card.ContextMenu>
                                    </hc:Card>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemContainerStyle">
                            <Setter.Value>
                                <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="ListBoxItem">
                                    <Setter Property="IsSelected" Value="{Binding Path=IsSelected}" />
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  筛选标签  -->
        <Grid Margin="10,4,10,0" Visibility="{Binding ShowFilterLabelPanel, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
            <hc:TagContainer
                Grid.Column="1"
                BorderThickness="0"
                ItemsSource="{Binding FilterLabels}">
                <hc:TagContainer.ItemContainerStyle>
                    <Style BasedOn="{StaticResource TagBaseStyle}" TargetType="hc:Tag">
                        <Setter Property="Content" Value="{Binding Name}" />
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="IsSelected" Value="True" />
                    </Style>
                </hc:TagContainer.ItemContainerStyle>
            </hc:TagContainer>
        </Grid>

        <Grid Grid.Row="1">
            <controls:Canvas
                x:Name="MainCanva"
                Margin="0,0,3,0"
                Background="Transparent"
                MouseLeftButtonDown="MainCanva_MouseButtonDown"
                SizeChanged="{s:Action SizeChanged}">
                <ListBox
                    controls:ScrollViewerMonitor.AtEndCommand="{s:Action FetchMorePicture}"
                    hc:Tag.Closing="{s:Action DeletePictureLabel}"
                    ItemsSource="{Binding Pictures}"
                    SelectionChanged="{s:Action PictureSelectionChange}"
                    Style="{DynamicResource PictureListBox}"
                    Visibility="{Binding IsGroup, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}" />
                <hc:ScrollViewer
                    Margin="0"
                    controls:ScrollViewerMonitor.AtEndCommand="{s:Action FetchMorePicture}"
                    hc:Tag.Closing="{s:Action DeletePictureLabel}"
                    Visibility="{Binding IsGroup, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl hc:Tag.Closing="{s:Action DeletePictureLabel}" ItemsSource="{Binding PictureGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander
                                    Margin="0,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsExpanded="True"
                                    Style="{DynamicResource ExpanderBaseStyle}">
                                    <Expander.Header>
                                        <StackPanel Margin="4,6,0,6" Orientation="Horizontal">
                                            <Border
                                                Width="3"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource PrimaryBrush}"
                                                CornerRadius="2" />
                                            <TextBlock
                                                Margin="9,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Text="{Binding Key}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ListBox
                                        Margin="0,0,0,6"
                                        ItemsSource="{Binding}"
                                        PreviewMouseWheel="InnerLB_PreviewMouseWheel"
                                        SelectionChanged="{s:Action PictureSelectionChange}"
                                        Style="{DynamicResource PictureListBox}" />
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </hc:ScrollViewer>

                <Canvas.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{s:Action UpdateOrderBy}"
                            CommandParameter="AddTime"
                            Header="按添加时间排序">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsOrderByAddTime, Converter={x:Static s:BoolToVisibilityConverter.Instance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{s:Action UpdateOrderBy}"
                            CommandParameter="Title"
                            Header="按标题排序">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsOrderByTitle, Converter={x:Static s:BoolToVisibilityConverter.Instance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{s:Action UpdateOrderBy}"
                            CommandParameter="AddState"
                            Header="按添加状态排序"
                            Visibility="{Binding IsAddPictureMode, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsOrderByAddingState, Converter={x:Static s:BoolToVisibilityConverter.Instance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{s:Action UpdateIsDesc}"
                            CommandParameter="False"
                            Header="顺序">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsDesc, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{s:Action UpdateIsDesc}"
                            CommandParameter="True"
                            Header="逆序">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsDesc, Converter={x:Static s:BoolToVisibilityConverter.Instance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{s:Action SetGroup}"
                            CommandParameter="False"
                            Header="不分组">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsGroup, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{s:Action SetGroup}"
                            CommandParameter="True"
                            Header="分组">
                            <MenuItem.Icon>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="●"
                                    Visibility="{Binding IsGroup, Converter={x:Static s:BoolToVisibilityConverter.Instance}}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{s:Action RefreshPicture}" Header="刷新" />
                    </ContextMenu>
                </Canvas.ContextMenu>
            </controls:Canvas>

            <!--  空态  -->
            <Grid Background="{DynamicResource AppPageBrush}" Visibility="{Binding HasPictures, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                <StackPanel
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid
                        Width="148"
                        Height="148"
                        HorizontalAlignment="Center">
                        <Rectangle
                            Width="100"
                            Height="82"
                            Margin="16,30,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource AppSurfaceBrush}"
                            RadiusX="16"
                            RadiusY="16"
                            Stroke="{DynamicResource AppStrokeBrush}"
                            StrokeThickness="2.4" />
                        <Rectangle
                            Width="76"
                            Height="58"
                            Margin="28,42,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            RadiusX="10"
                            RadiusY="10"
                            Stroke="{DynamicResource AppStrokeBrush}"
                            StrokeDashArray="5 5"
                            StrokeThickness="2" />
                        <Path
                            Width="46"
                            Height="20"
                            Margin="34,62,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Data="M2 18L14 6l8 8 7-6 13 10"
                            Stretch="Fill"
                            Stroke="{DynamicResource AppStrokeBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2.4" />
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="45,52,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource AppStrokeBrush}" />
                        <Ellipse
                            Width="46"
                            Height="46"
                            Margin="0,0,2,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Fill="{DynamicResource PrimaryBrush}" />
                        <Path
                            Width="20"
                            Height="20"
                            Margin="0,0,15,15"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="M12 5v14M5 12h14"
                            Stretch="Uniform"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="3" />
                    </Grid>
                    <TextBlock
                        Margin="0,18,0,6"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="还没有图片" />
                    <TextBlock
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        Text="把图片拖进窗口，或从文件夹批量添加" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Height="34"
                            Padding="16,0"
                            Command="{s:Action EmptyAddPictures}"
                            Style="{StaticResource ButtonPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Data="M12 5v14M5 12h14"
                                    Stretch="Uniform"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.4" />
                                <TextBlock VerticalAlignment="Center" Text="添加图片" />
                            </StackPanel>
                        </Button>
                        <Button
                            Height="34"
                            Margin="12,0,0,0"
                            Padding="16,0"
                            Command="{s:Action EmptyAddFolders}"
                            Style="{StaticResource ButtonDefault}">
                            <TextBlock VerticalAlignment="Center" Text="添加文件夹" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  加载骨架  -->
            <Grid Background="{DynamicResource AppPageBrush}" Visibility="{Binding IsLoading, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                <UniformGrid
                    Margin="18,10"
                    VerticalAlignment="Top"
                    Columns="5"
                    Rows="2">
                    <Border
                        Height="330"
                        Margin="6"
                        Background="{DynamicResource AppCardBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource AppCardShadow}">
                        <StackPanel>
                            <Border
                                Height="240"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="10,10,0,0" />
                            <Border
                                Height="10"
                                Margin="12,14,56,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="5" />
                            <Border
                                Height="8"
                                Margin="12,9,110,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                    </Border>
                    <Border
                        Height="330"
                        Margin="6"
                        Background="{DynamicResource AppCardBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource AppCardShadow}">
                        <StackPanel>
                            <Border
                                Height="240"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="10,10,0,0" />
                            <Border
                                Height="10"
                                Margin="12,14,56,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="5" />
                            <Border
                                Height="8"
                                Margin="12,9,110,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                    </Border>
                    <Border
                        Height="330"
                        Margin="6"
                        Background="{DynamicResource AppCardBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource AppCardShadow}">
                        <StackPanel>
                            <Border
                                Height="240"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="10,10,0,0" />
                            <Border
                                Height="10"
                                Margin="12,14,56,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="5" />
                            <Border
                                Height="8"
                                Margin="12,9,110,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                    </Border>
                    <Border
                        Height="330"
                        Margin="6"
                        Background="{DynamicResource AppCardBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource AppCardShadow}">
                        <StackPanel>
                            <Border
                                Height="240"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="10,10,0,0" />
                            <Border
                                Height="10"
                                Margin="12,14,56,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="5" />
                            <Border
                                Height="8"
                                Margin="12,9,110,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                    </Border>
                    <Border
                        Height="330"
                        Margin="6"
                        Background="{DynamicResource AppCardBrush}"
                        BorderBrush="{DynamicResource AppStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource AppCardShadow}">
                        <StackPanel>
                            <Border
                                Height="240"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="10,10,0,0" />
                            <Border
                                Height="10"
                                Margin="12,14,56,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="5" />
                            <Border
                                Height="8"
                                Margin="12,9,110,0"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>

        <!--  状态栏  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppStrokeBrush}"
            BorderThickness="0,1,0,0">
            <Grid Height="42" Margin="18,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,1,8,0"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource PrimaryBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding PictureNum, StringFormat={}{0:N0} 张图片}" />
                    <Grid Margin="10,0,0,0" Visibility="{Binding HasSelection, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                        <Border
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="999"
                            Opacity="0.12" />
                        <TextBlock
                            Margin="9,3"
                            FontSize="11"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding SelectPictureNum, StringFormat='已选 {0}'}" />
                    </Grid>
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="14"
                        Height="14"
                        Margin="0,0,10,0"
                        Data="M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6"
                        Stretch="Uniform"
                        Stroke="{DynamicResource ThirdlyTextBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="1.6" />
                    <Slider
                        Width="130"
                        Maximum="{Binding MaxCardWidth, Mode=OneWay}"
                        Minimum="120"
                        Style="{StaticResource AppCardWidthSlider}"
                        Value="{Binding CardWidth}" />
                    <TextBlock
                        Width="42"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding CardWidth, StringFormat={}{0:0} px}"
                        TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

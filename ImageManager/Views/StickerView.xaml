<hc:Window
    x:Class="ImageManager.Views.StickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:viewModels="clr-namespace:ImageManager.ViewModels"
    Title="StickerView"
    Width="400"
    Height="400"
    d:DataContext="{d:DesignInstance Type=viewModels:StickerViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    BorderThickness="0"
    ContextMenuService.IsEnabled="{Binding IsFolded, Converter={StaticResource Boolean2BooleanReConverter}}"
    MouseDoubleClick="{s:Action MouseDoubleClick}"
    MouseDown="Window_MouseDown"
    MouseWheel="{s:Action MouseWheel}"
    Opacity="{Binding WindowOpacity}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowNonClientArea="False"
    ShowTitle="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <hc:Window.InputBindings>
        <KeyBinding
            Key="W"
            Command="{s:Action CloseWindow}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="C"
            Command="{s:Action CopyImage}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="OemOpenBrackets"
            Command="{s:Action IncreaseZoom}"
            CommandParameter="-0.1"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="OemCloseBrackets"
            Command="{s:Action IncreaseZoom}"
            CommandParameter="0.1"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Subtract"
            Command="{s:Action IncreaseOpacity}"
            CommandParameter="-0.1"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Add"
            Command="{s:Action IncreaseOpacity}"
            CommandParameter="0.1"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Delete"
            Command="{s:Action IncreaseRotate}"
            CommandParameter="-15" />
        <KeyBinding
            Key="End"
            Command="{s:Action IncreaseRotate}"
            CommandParameter="15" />
    </hc:Window.InputBindings>
    <hc:Window.ContextMenu>
        <ContextMenu>
            <MenuItem
                Command="{s:Action CloseWindow}"
                Header="关闭"
                InputGestureText="Ctrl+W" />
            <MenuItem Header="参考图列表" ItemsSource="{x:Static viewModels:StickerViewModel.Instances}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:StickerViewModelWrapper}">
                        <Image Source="{Binding ThumbnailSource}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{s:Action CopyImage}"
                Header="复制图像"
                InputGestureText="Ctrl+C" />
            <Separator />
            <MenuItem
                Command="{s:Action IncreaseZoom}"
                CommandParameter="-0.1"
                Header="缩小"
                InputGestureText="Ctrl+[" />
            <MenuItem
                Command="{s:Action IncreaseZoom}"
                CommandParameter="0.1"
                Header="放大"
                InputGestureText="Ctrl+]" />
            <MenuItem Header="缩放">
                <MenuItem
                    Command="{s:Action ZoomTo}"
                    CommandParameter="0.1"
                    Header="缩放为10%" />
                <MenuItem
                    Command="{s:Action ZoomTo}"
                    CommandParameter="0.5"
                    Header="缩放为50%" />
                <MenuItem
                    Command="{s:Action ZoomTo}"
                    CommandParameter="1.0"
                    Header="缩放为100%" />
                <MenuItem
                    Command="{s:Action ZoomTo}"
                    CommandParameter="2.0"
                    Header="缩放为200%" />
            </MenuItem>
            <Separator />
            <MenuItem Header="旋转">
                <MenuItem
                    Command="{s:Action IncreaseRotate}"
                    CommandParameter="90"
                    Header="顺时针旋转90°" />
                <MenuItem
                    Command="{s:Action IncreaseRotate}"
                    CommandParameter="-90"
                    Header="逆时针旋转90°" />
                <Separator />
                <MenuItem
                    Command="{s:Action IncreaseRotate}"
                    CommandParameter="15"
                    Header="顺时针+15°" />
                <MenuItem
                    Command="{s:Action IncreaseRotate}"
                    CommandParameter="-15"
                    Header="逆时针-15°" />
                <MenuItem
                    Command="{s:Action IncreaseRotate}"
                    CommandParameter="1"
                    Header="顺时针+1°" />
                <MenuItem
                    Command="{s:Action IncreaseRotate}"
                    CommandParameter="-1"
                    Header="逆时针-1°" />
                <Separator />
                <MenuItem Command="{s:Action ResetRotation}" Header="重置旋转" />
            </MenuItem>
            <MenuItem Command="{s:Action HorizontalFlip}" Header="水平翻转" />
            <MenuItem Command="{s:Action VerticalFlip}" Header="垂直翻转" />
            <Separator />
            <MenuItem Header="透明度">
                <MenuItem
                    Command="{s:Action SetOpacity}"
                    CommandParameter="0.1"
                    Header="透明度为10%" />
                <MenuItem
                    Command="{s:Action SetOpacity}"
                    CommandParameter="0.5"
                    Header="透明度为50%" />
                <MenuItem
                    Command="{s:Action SetOpacity}"
                    CommandParameter="1.0"
                    Header="透明度为100%" />
                <Separator />
                <MenuItem
                    Command="{s:Action IncreaseOpacity}"
                    CommandParameter="-0.1"
                    Header="减少透明度"
                    InputGestureText="Ctrl+Subtract" />
                <MenuItem
                    Command="{s:Action IncreaseOpacity}"
                    CommandParameter="0.1"
                    Header="增加透明度"
                    InputGestureText="Ctrl+Add" />
            </MenuItem>
            <Separator />
            <MenuItem Command="{s:Action AddToDatabase}" Header="添加图像到数据库" />
        </ContextMenu>
    </hc:Window.ContextMenu>
    <Border BorderBrush="Gray" BorderThickness="2">
        <Image
            x:Name="StickerImage"
            Width="{Binding DisplayWidth}"
            Height="{Binding DisplayHeight}"
            SnapsToDevicePixels="True"
            Source="{Binding ImageSource}"
            UseLayoutRounding="True" />
        <Border.LayoutTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}" />
                <RotateTransform Angle="{Binding RotationAngle}" />
            </TransformGroup>
        </Border.LayoutTransform>
    </Border>
</hc:Window>

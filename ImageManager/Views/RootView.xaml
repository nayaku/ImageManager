<hc:Window
    x:Class="ImageManager.Views.RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:ImageManager.Data.Model"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:themes="clr-namespace:ImageManager.Themes"
    xmlns:viewModels="clr-namespace:ImageManager.ViewModels"
    Title="素材管理姬"
    Width="1280"
    Height="768"
    MinWidth="900"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=viewModels:RootViewModel}"
    Icon="pack://application:,,,/icon.ico"
    Loaded="{s:Action Loaded}"
    MouseDown="{s:Action WindowMouseDown}"
    ShowIcon="True"
    ShowTitle="False"
    WindowStartupLocation="CenterScreen"
    WindowState="{Binding WindowState}"
    mc:Ignorable="d">
    <hc:Window.InputBindings>
        <KeyBinding Command="{s:Action ScreenShot}" Gesture="Ctrl+Alt+Shift+X" />
        <KeyBinding
            Key="O"
            Command="{s:Action AddPictures}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="O"
            Command="{s:Action AddFolders}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="A"
            s:View.ActionTarget="{Binding MainPageViewModel}"
            Command="{s:Action SelectAll}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D"
            s:View.ActionTarget="{Binding MainPageViewModel}"
            Command="{s:Action SelectNone}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="I"
            s:View.ActionTarget="{Binding MainPageViewModel}"
            Command="{s:Action SelectInvert}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="C"
            s:View.ActionTarget="{Binding MainPageViewModel}"
            Command="{s:Action CopyPicture}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Delete"
            s:View.ActionTarget="{Binding MainPageViewModel}"
            Command="{s:Action DeletePicture}" />
    </hc:Window.InputBindings>
    <hc:Window.NonClientAreaContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  应用头 + 功能  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="素材管理姬" />
                <hc:Divider
                    MaxHeight="16"
                    Margin="12,0,8,0"
                    LineStroke="{DynamicResource AppStrokeBrush}"
                    LineStrokeThickness="1"
                    Orientation="Vertical" />
                <Menu VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="图片" SubmenuOpened="{s:Action PictureMenuSubmenuOpened}">
                        <MenuItem
                            Command="{s:Action AddPictures}"
                            Header="添加图片"
                            InputGestureText="Ctrl+O" />
                        <MenuItem
                            Command="{s:Action AddFolders}"
                            Header="添加文件夹"
                            InputGestureText="Ctrl+Shift+O" />
                        <Separator />
                        <MenuItem
                            Command="{s:Action AddClipboardImage}"
                            Header="从剪贴板添加图片"
                            IsEnabled="{Binding IsClipboardContainsImage}" />
                        <MenuItem
                            Command="{s:Action StickClipboardImage}"
                            Header="从剪贴板创建贴片"
                            IsEnabled="{Binding IsClipboardContainsImage}" />
                        <Separator />
                        <MenuItem Command="{s:Action ImportData}" Header="导入数据库" />
                        <MenuItem Command="{s:Action ExportData}" Header="导出数据库" />
                        <Separator />
                        <MenuItem
                            Command="{s:Action ScreenShot}"
                            Header="截图"
                            InputGestureText="Ctrl+Alt+Shift+X" />
                        <CheckBox Content="截图时隐藏" IsChecked="{Binding IsHideWhenScreenShoot}" />
                        <CheckBox Content="启动时还原贴片" IsChecked="{Binding RestoreStickerOnStartup}" />
                    </MenuItem>
                    <MenuItem Header="选择">
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action SelectAll}"
                            Header="选择全部"
                            InputGestureText="Ctrl+A" />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action SelectNone}"
                            Header="取消选择"
                            InputGestureText="Ctrl+D" />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action SelectInvert}"
                            Header="反向选择"
                            InputGestureText="Ctrl+I" />
                        <Separator />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action StickPictureCommand}"
                            Header="贴片式打开" />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action OpenPictureWithExternalProgram}"
                            Header="使用外部程序打开" />
                        <Separator />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action CopyPicture}"
                            Header="拷贝图片"
                            InputGestureText="Ctrl+C" />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action CopyPicturePath}"
                            Header="拷贝图片路径" />
                        <Separator />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action AddPictureLabel}"
                            Header="添加标签" />
                        <MenuItem
                            s:View.ActionTarget="{Binding MainPageViewModel}"
                            Command="{s:Action DeletePicture}"
                            Header="删除图片"
                            InputGestureText="Delete" />
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem Command="{s:Action CheckUpdate}" Header="检测更新" />
                        <MenuItem Command="{s:Action About}" Header="关于" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!--  搜索  -->
            <hc:SearchBar
                Name="SearchLabelBar"
                Grid.Column="1"
                Width="270"
                Height="32"
                HorizontalAlignment="Right"
                hc:BorderElement.CornerRadius="16"
                hc:InfoElement.Placeholder="搜索标题 / 标签"
                Command="{s:Action SearchStarted}"
                CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}"
                GotFocus="{s:Action SearchBarGotFocus}"
                KeyDown="{s:Action SearchBarKeyDown}"
                LostFocus="{s:Action SearchBarLostFocus}"
                Style="{StaticResource SearchBarPlus}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="{s:Action UpdateSearchedLabels}" />

            <!--  标签搜索下拉  -->
            <Popup
                Grid.Column="1"
                Width="270"
                AllowsTransparency="True"
                IsOpen="{Binding ShowLabelPopup}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=SearchLabelBar}">
                <Border
                    Background="{DynamicResource AppCardBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource AppPopupShadow}">
                    <ListBox
                        Margin="4"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding SearchedLabels}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:Label}">
                                <Button
                                    Margin="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{s:Action LabelClick}"
                                    CommandParameter="{Binding}"
                                    Focusable="False">
                                    <Button.Content>
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Foreground="{DynamicResource ThirdlyTextBrush}"
                                                Text="{Binding NumToString}" />
                                        </Grid>
                                    </Button.Content>
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Padding="6,4" Background="Transparent">
                                                <ContentPresenter
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Content="{TemplateBinding Content}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                    RecognizesAccessKey="True" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Popup>

            <!--  主题入口  -->
            <Button
                Name="ThemeConfigButton"
                Grid.Column="2"
                Margin="6,0,4,0"
                VerticalAlignment="Center"
                hc:IconElement.Geometry="{StaticResource ConfigGeometry}"
                Command="{s:Action ShowThemeConfig}"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Style="{StaticResource ButtonIcon}"
                ToolTip="主题设置" />

            <!--  主题面板  -->
            <Popup
                AllowsTransparency="True"
                HorizontalOffset="-244"
                IsOpen="{Binding ThemeConfigShow}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=ThemeConfigButton}"
                StaysOpen="False"
                VerticalOffset="8">
                <Border
                    Width="272"
                    Padding="16"
                    Background="{DynamicResource AppCardBrush}"
                    BorderBrush="{DynamicResource AppStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource AppPopupShadow}">
                    <StackPanel>
                        <TextBlock
                            Margin="2,0,0,8"
                            FontSize="11.5"
                            Foreground="{DynamicResource ThirdlyTextBrush}"
                            Text="外观" />
                        <Border
                            Padding="3"
                            Background="{DynamicResource AppSurfaceBrush}"
                            CornerRadius="9">
                            <UniformGrid Columns="3">
                                <Button
                                    Command="{s:Action ChangeTheme}"
                                    CommandParameter="{x:Static themes:ThemeMode.Light}"
                                    Content="浅色">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource AppSegmentButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThemeMode}" Value="{x:Static themes:ThemeMode.Light}">
                                                    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{s:Action ChangeTheme}"
                                    CommandParameter="{x:Static themes:ThemeMode.Dark}"
                                    Content="深色">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource AppSegmentButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThemeMode}" Value="{x:Static themes:ThemeMode.Dark}">
                                                    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{s:Action ChangeTheme}"
                                    CommandParameter="{x:Static themes:ThemeMode.System}"
                                    Content="跟随系统">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource AppSegmentButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThemeMode}" Value="{x:Static themes:ThemeMode.System}">
                                                    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </Border>

                        <TextBlock
                            Margin="2,16,0,10"
                            FontSize="11.5"
                            Foreground="{DynamicResource ThirdlyTextBrush}"
                            Text="强调色" />

                        <!--  跟随系统：显示系统提供的强调色  -->
                        <StackPanel
                            Margin="0,0,0,10"
                            Orientation="Horizontal"
                            Visibility="{Binding IsAccentSelectable, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}">
                            <Ellipse
                                Width="26"
                                Height="26"
                                Fill="{Binding SystemAccentBrush}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="系统强调色" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource ThirdlyTextBrush}"
                                Text="跟随 Windows" />
                        </StackPanel>

                        <StackPanel IsEnabled="{Binding IsAccentSelectable}" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button
                                Background="{StaticResource AppAccent0}"
                                Command="{s:Action ChangeAccent}"
                                CommandParameter="0"
                                ToolTip="蓝">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AppAccentDot}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccentIndex}" Value="0">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Background="{StaticResource AppAccent1}"
                                Command="{s:Action ChangeAccent}"
                                CommandParameter="1"
                                ToolTip="紫">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AppAccentDot}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccentIndex}" Value="1">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Background="{StaticResource AppAccent2}"
                                Command="{s:Action ChangeAccent}"
                                CommandParameter="2"
                                ToolTip="粉">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AppAccentDot}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccentIndex}" Value="2">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Background="{StaticResource AppAccent3}"
                                Command="{s:Action ChangeAccent}"
                                CommandParameter="3"
                                ToolTip="橙">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AppAccentDot}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccentIndex}" Value="3">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Background="{StaticResource AppAccent4}"
                                Command="{s:Action ChangeAccent}"
                                CommandParameter="4"
                                ToolTip="绿">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AppAccentDot}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccentIndex}" Value="4">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                Margin="0"
                                Background="{StaticResource AppAccent5}"
                                Command="{s:Action ChangeAccent}"
                                CommandParameter="5"
                                ToolTip="靛灰">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource AppAccentDot}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccentIndex}" Value="5">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,16,0,10"
                            Background="{DynamicResource AppStrokeBrush}" />
                        <Button
                            HorizontalAlignment="Left"
                            Command="{s:Action ResetAppearance}"
                            Content="恢复默认"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource AppSegmentButton}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </hc:Window.NonClientAreaContent>
    <hc:SimplePanel
        AllowDrop="True"
        Drop="{s:Action Drop}"
        PreviewDragOver="{s:Action DragOver}">
        <ContentControl x:Name="MainPage" s:View.Model="{Binding MainPageViewModel}" />
        <ScrollViewer HorizontalAlignment="Right" VerticalScrollBarVisibility="Hidden">
            <StackPanel
                Margin="0,10,0,10"
                VerticalAlignment="Top"
                hc:Growl.Token="RootViewMessage" />
        </ScrollViewer>
    </hc:SimplePanel>
</hc:Window>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!--  圆角  -->
    <CornerRadius x:Key="AppCardCorner">10</CornerRadius>
    <CornerRadius x:Key="AppPanelCorner">12</CornerRadius>

    <!--  阴影  -->
    <DropShadowEffect
        x:Key="AppCardShadow"
        BlurRadius="10"
        Direction="270"
        Opacity="0.10"
        ShadowDepth="1"
        Color="#101828" />
    <DropShadowEffect
        x:Key="AppHoverShadow"
        BlurRadius="20"
        Direction="270"
        Opacity="0.16"
        ShadowDepth="4"
        Color="#101828" />
    <DropShadowEffect
        x:Key="AppPopupShadow"
        BlurRadius="26"
        Direction="270"
        Opacity="0.18"
        ShadowDepth="6"
        Color="#101828" />

    <!--  可选强调色（与 AppTheme 的取值顺序一致）  -->
    <SolidColorBrush x:Key="AppAccent0" Color="#3B7BF6" />
    <SolidColorBrush x:Key="AppAccent1" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AppAccent2" Color="#EC4899" />
    <SolidColorBrush x:Key="AppAccent3" Color="#F59E0B" />
    <SolidColorBrush x:Key="AppAccent4" Color="#10B981" />
    <SolidColorBrush x:Key="AppAccent5" Color="#64748B" />

    <!--  键盘焦点框  -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-2"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Opacity="0.7"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  卡片底部的小标签（胶囊）  -->
    <Style x:Key="AppTagPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <!--  统计胶囊  -->
    <Style x:Key="AppCountPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

    <!--  主题面板里的分段按钮  -->
    <Style x:Key="AppSegmentButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  强调色圆点  -->
    <Style x:Key="AppAccentDot" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  「不添加」提示：深色底片 + 浅色文字，明暗主题通用  -->
    <SolidColorBrush x:Key="AppRejectChipBrush" Color="#9E101828" />
    <SolidColorBrush x:Key="AppRejectChipStrokeBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="AppRejectChipTextBrush" Color="#F2F4F7" />

    <!--  圆形勾选框：未勾时的描边与底  -->
    <SolidColorBrush x:Key="AppCheckRingBrush" Color="#CC9AA3AF" />
    <SolidColorBrush x:Key="AppCheckFillBrush" Color="#4D101828" />

    <!--  圆形勾选框（接受 / 未接受）  -->
    <Style x:Key="AppCircleCheck" TargetType="CheckBox">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Margin" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Ellipse
                            x:Name="Ring"
                            Fill="{StaticResource AppCheckFillBrush}"
                            Stroke="{StaticResource AppCheckRingBrush}"
                            StrokeThickness="2" />
                        <Path
                            x:Name="Tick"
                            Width="11"
                            Height="11"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M5 13l4 4L19 7"
                            Stretch="Uniform"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="3"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  卡片上的圆形快捷按钮  -->
    <Style x:Key="AppRoundIconButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse
                            Fill="{TemplateBinding Background}"
                            Stroke="{DynamicResource AppStrokeBrush}"
                            StrokeThickness="1" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
